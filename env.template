# Flask Configuration
FLASK_SECRET_KEY=your-secret-key-here-change-this
JWT_SECRET_KEY=your-jwt-secret-key-here-change-this

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password-here
MYSQL_DATABASE=codedonki

# Google Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key-here

# Flask Environment
FLASK_ENV=development
DEBUG=True

# Instructions:
# 1. Copy this file to .env
# 2. Replace all placeholder values with your actual keys
# 3. Never commit .env to version control
# 4. Get Gemini API key from: https://makersuite.google.com/app/apikey
# 5. For cloud MySQL (e.g. PlanetScale, Railway, Aiven), set MYSQL_HOST to
#    the remote host and update MYSQL_PORT/USER/PASSWORD/DATABASE accordingly.
